# Persistent RunPod mount
WORKSPACE=/workspace
MODELS_DIR=/workspace/models

# Download required models on startup. Existing files are skipped.
DOWNLOAD_MODELS=1

# Default speed LoRA
DOWNLOAD_H3_FL2V_4STEP_LORA=0

# Optional
DOWNLOAD_H3_FL2V_8STEP_LORA=0
DOWNLOAD_H3_REF2V_4STEP_LORA=0

# Only needed if Hugging Face requires auth/rate-limit relief.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxx

# Extra ComfyUI launch arguments, if needed.
# COMFYUI_ARGS=--highvram
